{
  "name": "bastproxy-webclient-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The Svelte web app of bastproxy-webclient",
  "license": "MIT",
  "engines": {
    "node": ">=22.22.1"
  },
  "scripts": {
    "build": "vite build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "vitest run --coverage",
    "deadcode": "knip",
    "licenses": "node scripts/check-licenses.mjs",
    "sbom": "cyclonedx-npm --output-format JSON --output-file ../../tmp/sbom-web.json --omit peer"
  },
  "devDependencies": {
    "@cyclonedx/cyclonedx-npm": "7.0.1",
    "@eslint/js": "10.0.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.1.1",
    "eslint": "10.15.0",
    "eslint-plugin-no-unsanitized": "4.1.5",
    "eslint-plugin-svelte": "3.24.1",
    "jsdom": "29.1.1",
    "knip": "6.45.1",
    "prettier": "3.10.1",
    "prettier-plugin-svelte": "4.1.1",
    "svelte": "5.57.3",
    "svelte-check": "4.7.8",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
